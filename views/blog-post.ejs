<%- include('partials/header') %>

<div class="bg-[#fefbf0] text-slate-900 antialiased min-h-screen flex flex-col relative overflow-x-hidden">
  
  <div class="absolute inset-0 opacity-[0.008] pointer-events-none select-none z-0">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full min-h-screen" viewBox="0 0 1200 1000" preserveAspectRatio="xMidYMid slice">
      <g stroke="#000" stroke-width="12" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <g transform="translate(650, 180)"><circle cx="90" cy="90" r="80"/><path d="M60 75 Q75 60 90 75 M100 75 Q115 60 130 75" stroke-width="14"/><path d="M50 105 Q90 150 130 105 Z" fill="#000" opacity="0.15"/></g>
        <g transform="translate(180, 80)"><circle cx="70" cy="70" r="62"/><path d="M45 55 Q57 43 70 55 M75 55 Q87 43 100 55" stroke-width="10"/><path d="M40 80 Q70 115 100 80 Z" fill="#000" opacity="0.15"/></g>
        <g transform="translate(920, 90)"><circle cx="78" cy="78" r="70"/><circle cx="56" cy="68" r="6" fill="#000"/><circle cx="100" cy="68" r="6" fill="#000"/><path d="M54 112 Q78 130 102 112"/></g>
        <g transform="translate(100, 380)"><circle cx="60" cy="60" r="54"/><circle cx="43" cy="52" r="5" fill="#000"/><circle cx="77" cy="52" r="5" fill="#000"/><path d="M42 82 Q60 98 78 82"/></g>
        <g transform="translate(480, 420)"><circle cx="78" cy="78" r="70"/><circle cx="56" cy="68" r="6" fill="#000"/><circle cx="100" cy="68" r="6" fill="#000"/><path d="M54 112 Q78 132 102 112"/></g>
        <g transform="translate(880, 440)"><circle cx="70" cy="70" r="62"/><path d="M45 55 Q57 43 70 55 M75 55 Q87 43 100 55" stroke-width="10"/><path d="M40 80 Q70 115 100 80 Z" fill="#000" opacity="0.15"/></g>
      </g>
    </svg>
  </div>

  <div class="relative z-10 flex-grow">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
      
      <!-- Breadcrumb -->
      <div class="mb-4">
        <a href="/blog" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">← Back to Blog</a>
      </div>

      <!-- Blog Post -->
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
        <div class="p-6 sm:p-8">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-xs text-slate-500"><%= new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
            <span class="text-xs text-slate-400">•</span>
            <span class="text-xs text-slate-500"><%= post.readTime %></span>
            <% if (post.tags) { %>
              <span class="text-xs text-slate-400">•</span>
              <span class="flex gap-1">
                <% for (var t = 0; t < post.tags.length; t++) { %>
                  <span class="bg-slate-100 text-slate-600 text-xs px-2 py-0.5 rounded-full"><%= post.tags[t] %></span>
                <% } %>
              </span>
            <% } %>
          </div>
          
          <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4"><%= post.title %></h1>
          
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-700 font-bold text-sm">SS</div>
            <div>
              <div class="font-semibold text-slate-900 text-sm">School Sentiment Team</div>
            </div>
          </div>

          <div class="prose prose-slate max-w-none blog-content">
            <%- post.content %>
          </div>

          <div class="border-t border-slate-200 pt-6 mt-8">
            <h4 class="text-sm font-bold text-slate-800 mb-3">Share this article</h4>
            <div class="flex flex-wrap gap-3">
              <a href="https://twitter.com/intent/tweet?url=https://schoolsentiment.co.uk/blog/<%= post.slug %>&text=<%= encodeURIComponent(post.title) %>" target="_blank" rel="noopener noreferrer" class="bg-black hover:bg-slate-800 text-white text-xs font-semibold px-4 py-2 rounded-full transition-all">Twitter</a>
              <a href="https://www.facebook.com/sharer/sharer.php?u=https://schoolsentiment.co.uk/blog/<%= post.slug %>" target="_blank" rel="noopener noreferrer" class="bg-black hover:bg-slate-800 text-white text-xs font-semibold px-4 py-2 rounded-full transition-all">Facebook</a>
              <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" class="bg-black hover:bg-slate-800 text-white text-xs font-semibold px-4 py-2 rounded-full transition-all">Instagram</a>
              <a href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer" class="bg-red-600 hover:bg-red-700 text-white text-xs font-semibold px-4 py-2 rounded-full transition-all">YouTube</a>
              <a href="https://www.tiktok.com/" target="_blank" rel="noopener noreferrer" class="bg-black hover:bg-slate-800 text-white text-xs font-semibold px-4 py-2 rounded-full transition-all">TikTok</a>
              <a href="mailto:?subject=<%= encodeURIComponent(post.title) %>&body=Check%20out%20this%20article%3A%20https%3A%2F%2Fschoolsentiment.co.uk%2Fblog%2F<%= post.slug %>" class="bg-black hover:bg-slate-800 text-white text-xs font-semibold px-4 py-2 rounded-full transition-all">Email</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Back to Blog -->
      <div class="mt-6 text-center">
        <a href="/blog" class="text-indigo-600 hover:text-indigo-800 font-medium text-sm hover:underline">← Back to all posts</a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
