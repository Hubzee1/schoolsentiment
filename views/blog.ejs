<%- include('partials/header') %>

<div class="bg-[#fefbf0] text-slate-900 antialiased min-h-screen flex flex-col relative overflow-x-hidden">
  
  <div class="absolute inset-0 opacity-[0.008] pointer-events-none select-none z-0">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full min-h-screen" viewBox="0 0 1200 1000" preserveAspectRatio="xMidYMid slice">
      <g stroke="#000" stroke-width="12" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <g transform="translate(650, 180)"><circle cx="90" cy="90" r="80"/><path d="M60 75 Q75 60 90 75 M100 75 Q115 60 130 75" stroke-width="14"/><path d="M50 105 Q90 150 130 105 Z" fill="#000" opacity="0.15"/></g>
        <g transform="translate(180, 80)"><circle cx="70" cy="70" r="62"/><path d="M45 55 Q57 43 70 55 M75 55 Q87 43 100 55" stroke-width="10"/><path d="M40 80 Q70 115 100 80 Z" fill="#000" opacity="0.15"/></g>
        <g transform="translate(920, 90)"><circle cx="78" cy="78" r="70"/><circle cx="56" cy="68" r="6" fill="#000"/><circle cx="100" cy="68" r="6" fill="#000"/><path d="M54 112 Q78 130 102 112"/></g>
        <g transform="translate(100, 380)"><circle cx="60" cy="60" r="54"/><circle cx="43" cy="52" r="5" fill="#000"/><circle cx="77" cy="52" r="5" fill="#000"/><path d="M42 82 Q60 98 78 82"/></g>
        <g transform="translate(480, 420)"><circle cx="78" cy="78" r="70"/><circle cx="56" cy="68" r="6" fill="#000"/><circle cx="100" cy="68" r="6" fill="#000"/><path d="M54 112 Q78 132 102 112"/></g>
        <g transform="translate(880, 440)"><circle cx="70" cy="70" r="62"/><path d="M45 55 Q57 43 70 55 M75 55 Q87 43 100 55" stroke-width="10"/><path d="M40 80 Q70 115 100 80 Z" fill="#000" opacity="0.15"/></g>
        <g transform="translate(250, 680)"><circle cx="110" cy="110" r="98"/><path d="M70 95 Q90 75 110 95 M120 95 Q140 75 160 95" stroke-width="16"/><path d="M55 135 Q110 195 165 135 Z" fill="#000" opacity="0.15"/></g>
        <g transform="translate(710, 700)"><circle cx="60" cy="60" r="54"/><circle cx="43" cy="52" r="5" fill="#000"/><circle cx="77" cy="52" r="5" fill="#000"/><path d="M42 82 Q60 98 78 82"/></g>
        <g transform="translate(940, 740)"><circle cx="85" cy="85" r="76"/><path d="M55 75 Q70 60 85 75 M95 75 Q110 60 125 75" stroke-width="12"/><path d="M48 110 Q85 155 122 110 Z" fill="#000" opacity="0.15"/></g>
      </g>
    </svg>
  </div>

  <div class="relative z-10 flex-grow">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
      
      <!-- Header -->
      <div class="border-b border-slate-200 pb-4 mb-6">
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">School Sentiment Blog</h1>
        <p class="text-xs text-slate-500 mt-1 font-medium">Insights, stories, and perspectives on education and school communities</p>
      </div>

      <!-- Featured Post (most recent) -->
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all mb-8">
        <div class="h-56 sm:h-64 overflow-hidden">
          <img src="<%= posts[0].featuredImage %>" alt="<%= posts[0].title %>" class="w-full h-full object-cover">
        </div>
        <div class="p-6 sm:p-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="bg-emerald-100 text-emerald-700 text-xs font-bold px-2 py-1 rounded-full">Latest Post</span>
            <span class="text-xs text-slate-500"><%= posts[0].tags ? posts[0].tags[0] : 'Education' %></span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-3"><%= posts[0].title %></h2>
          <p class="text-slate-600 mb-4"><%= posts[0].excerpt %></p>
          <div class="flex items-center justify-between flex-wrap gap-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-700 font-bold text-sm">SS</div>
              <div>
                <div class="font-semibold text-slate-900 text-sm">School Sentiment Team</div>
                <div class="text-xs text-slate-400"><%= new Date(posts[0].date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %> • <%= posts[0].readTime %></div>
              </div>
            </div>
            <a href="/blog/<%= posts[0].slug %>" class="text-indigo-600 hover:text-indigo-800 font-semibold text-sm hover:underline">Read Full Article →</a>
          </div>
        </div>
      </div>

      <!-- All Posts -->
      <h2 class="text-xl font-bold text-slate-900 mb-4">All Posts</h2>
      <div class="space-y-4">
        <% for (var i = 1; i < posts.length; i++) { 
          var post = posts[i];
        %>
          <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all">
            <div class="flex flex-col sm:flex-row">
              <div class="sm:w-48 h-48 sm:h-auto overflow-hidden flex-shrink-0">
                <img src="<%= post.featuredImage %>" alt="<%= post.title %>" class="w-full h-full object-cover">
              </div>
              <div class="p-5 flex-1">
                <div class="flex flex-col h-full justify-between">
                  <div>
                    <h3 class="font-bold text-slate-900 text-base hover:text-indigo-600 transition">
                      <a href="/blog/<%= post.slug %>"><%= post.title %></a>
                    </h3>
                    <p class="text-slate-500 text-sm mt-1"><%= post.excerpt %></p>
                    <div class="flex items-center gap-3 mt-2 text-xs text-slate-400">
                      <span><%= new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                      <span>•</span>
                      <span><%= post.readTime %></span>
                      <% if (post.tags) { %>
                        <span>•</span>
                        <span class="flex gap-1">
                          <% for (var t = 0; t < post.tags.length; t++) { %>
                            <span class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full"><%= post.tags[t] %></span>
                          <% } %>
                        </span>
                      <% } %>
                    </div>
                  </div>
                  <div class="flex items-center justify-between mt-3">
                    <div class="flex items-center gap-2">
                      <div class="w-7 h-7 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-700 font-bold text-[10px]">SS</div>
                      <span class="text-xs text-slate-600">School Sentiment Team</span>
                    </div>
                    <a href="/blog/<%= post.slug %>" class="text-indigo-600 hover:text-indigo-800 font-medium text-sm whitespace-nowrap hover:underline">Read More →</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Subscribe / CTA -->
      <div class="mt-10 bg-black rounded-2xl p-6 sm:p-8 text-center shadow-md border border-slate-200">
        <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">Never Miss a Post</h3>
        <p class="text-slate-300 mb-5 max-w-md mx-auto">Get the latest education insights and school stories straight to your inbox.</p>
        <a href="/signin" class="inline-block bg-white hover:bg-slate-100 text-black font-semibold px-6 py-2 rounded-full text-sm transition-all">Subscribe for Updates</a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
